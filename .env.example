# Vaga Certa — exemplo sem segredos.
# O backend lê estas variáveis com o prefixo PULSO_ (pydantic-settings).

PULSO_ENVIRONMENT=local
PULSO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Raiz do extrato da SME, clonado FORA deste repositório:
#   git clone https://github.com/CIT-SME-RJ/dadoscreche
# Nenhum arquivo dele é versionado.
PULSO_DADOSCRECHE_ROOT=../dadoscreche

# O modo fake é o padrão em desenvolvimento e testes.
# Preencher a chave apenas localmente, quando o uso real for autorizado.
PULSO_AI_PROVIDER=fake
PULSO_ANTHROPIC_API_KEY=

# Frontend (Vite).
VITE_API_BASE=http://127.0.0.1:8000
