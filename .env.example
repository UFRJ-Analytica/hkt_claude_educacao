# Pulso da Rede — exemplo sem segredos
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Paths locais; conteúdo gerado e bancos são ignorados pelo Git.
ANALYTICS_PATH=data/generated/pulso.duckdb
CONTROL_DB_PATH=data/generated/control.sqlite3
UPLOAD_DIR=uploads

# O modo fake deve ser o padrão em desenvolvimento e testes.
AGENT_MODEL_MODE=fake
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
ENABLE_EXTERNAL_ACTIONS=false

# Preencher apenas localmente quando o uso real for explicitamente autorizado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Privacidade e observabilidade
LOG_MODEL_PAYLOADS=false
ALLOW_PII=false
SMALL_GROUP_SUPPRESSION_THRESHOLD=10
