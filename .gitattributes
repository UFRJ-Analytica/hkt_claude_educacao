# Normalize text files in the repository and keep deterministic LF endings.
* text=auto

*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# Binary research and media artifacts must never be whitespace-checked as text.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
